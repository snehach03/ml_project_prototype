# Copy to .env (never commit the real file)

# PostgreSQL in production. If unset, a local SQLite file is used (fine for development).
# DATABASE_URL=postgresql://user:password@localhost:5432/stress_platform
DATABASE_URL=sqlite:///./stress_platform.db

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minimum seconds between two metric posts of one session (anti-flooding). Use 0 only for demos/tests.
MIN_METRIC_INTERVAL_SECONDS=20

# Privacy: sessions older than this are deleted at start-up
DATA_RETENTION_DAYS=90
MAX_SESSIONS_PER_CLIENT=200

# Serve the built React app from the API process (default: frontend/dist if it exists)
# FRONTEND_DIST=frontend/dist
